# =====================================================================
# GoShip Logistics - Environment Configuration Template
# =====================================================================
# To use: Copy this file to .env and configure values for your environment.
# Note: Never commit real credentials to GitHub or public repositories.

# Google Gemini AI (Smart Dispatch & Cargo Advisor)
# Generate key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Agora RTC Audio Engine (Voice Calling between Customer & Driver)
# Obtain credentials from Agora Console: https://console.agora.io
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_TOKEN=

# Firebase Platform Keys (Optional when using google-services.json & firebase_options.dart)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key_here
