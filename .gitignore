# =====================================================================
# GoShip Logistics - Git Ignore Rules
# =====================================================================

# 1. Flutter & Dart Build Artifacts
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/

# 2. Android & Mobile Build Artifacts (Prevent GitHub 100MB+ rejection)
*.apk
*.aab
/releases/
/android/app/debug/
/android/app/profile/
/android/app/release/
app.*.symbols
app.*.map.json
**/ios/Flutter/.last_build_id

# 3. Web Admin (Node.js, Vite & React)
**/node_modules/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 4. IDEs & Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.sublime-project
*.sublime-workspace

# 5. OS & Office Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
~$*
*.tmp
*.bak

# 6. Local Agent & Knowledge Graph Tooling
.agents/
graphify-out/
tools/
docs/

# 7. Python & Scripting Caches
__pycache__/
*.py[cod]
*$py.class
*.bak
*.tmp
*.log
firebase-debug.log*

# 8. Secrets & Cloud Credentials (Protect against GitHub Secret Scanning)
lib/firebase_options.dart
android/app/google-services.json
.env
.env.*
!.env.example
!*.example

# 9. Office Documents & Spreadsheet Test Cases (Local Reports)
*.docx
*.doc
*.xlsx
*.xls
*.csv


